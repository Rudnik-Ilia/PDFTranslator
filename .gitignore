# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# uv / packaging
*.egg-info/
dist/
build/

# Test/lint/type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
coverage.xml
htmlcov/

# Local environment files
.env
.env.*
!.env.example

# Editor/OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime logs
*.log

# Generated translator outputs / job state
out/
out_*/
outputs/
project_state.sqlite
*.sqlite
*.sqlite3

# Local PDFs/books and generated large artifacts
*.pdf
*.epub
*.mobi

# Keep documentation PDFs if intentionally added later
!docs/**/*.pdf
